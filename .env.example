# Viking user credentials are collected by the OAuth page, never by MCP tool arguments.
VIKING_WS_URL=wss://bot.fkviking.com/ws
VIKING_REQUEST_TIMEOUT_SECONDS=45
CREDENTIALS_IDLE_TTL_SECONDS=900
OAUTH_SESSION_IDLE_TTL_SECONDS=900
OAUTH_SESSION_MAX_TTL_SECONDS=28800
OAUTH_PERSISTENT_TOKEN_TTL_SECONDS=2592000

# Railway sets RAILWAY_PUBLIC_DOMAIN automatically after a public domain is added.
# For local HTTP development, set:
# PUBLIC_BASE_URL=http://127.0.0.1:8000

# Data delivery limits
INLINE_MAX_ROWS=500
INLINE_MAX_BYTES=200000
MAX_POINTS_PER_FIELD=500000
EXPORT_TTL_SECONDS=86400
EXPORT_DIR=./data/exports
# Infrastructure-only secret used to sign temporary CSV links and, by default,
# encrypt self-contained OAuth tokens. Set CREDENTIAL_TOKEN_KEY separately to rotate them independently.
EXPORT_SIGNING_KEY=replace-with-a-random-server-secret
# CREDENTIAL_TOKEN_KEY=replace-with-another-random-server-secret
