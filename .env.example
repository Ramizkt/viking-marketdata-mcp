# The server stores no Viking user credentials.
# Each MCP client sends its own credentials through X-Viking-* HTTP headers.
VIKING_WS_URL=wss://bot.fkviking.com/ws

# Railway sets RAILWAY_PUBLIC_DOMAIN automatically after a public domain is added.
# For local HTTP development, set:
# PUBLIC_BASE_URL=http://127.0.0.1:8000

# Data delivery limits
INLINE_MAX_ROWS=500
INLINE_MAX_BYTES=200000
MAX_POINTS_PER_FIELD=500000
EXPORT_TTL_SECONDS=86400
EXPORT_DIR=./data/exports
# Infrastructure-only secret used to sign temporary CSV links.
EXPORT_SIGNING_KEY=replace-with-a-random-server-secret
VIKING_REQUEST_TIMEOUT_SECONDS=45
