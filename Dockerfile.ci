# Never deploy this image. Production uses Dockerfile's final runtime stage.
ARG RUNTIME_IMAGE=viking-mcp-runtime:ci
FROM ${RUNTIME_IMAGE}
COPY --from=ghcr.io/astral-sh/uv:0.12.17 /uv /usr/local/bin/uv
ENV UV_PYTHON_DOWNLOADS=never \
    UV_LINK_MODE=copy \
    UV_NO_CACHE=1 \
    UV_PROJECT_ENVIRONMENT=/app/.venv
WORKDIR /checks
COPY pyproject.toml uv.lock README.md AGENTS.md Dockerfile Dockerfile.ci railway.json .dockerignore ./
COPY .github ./.github
COPY tests ./tests
COPY scripts ./scripts
# Add only locked test tools. Do not reinstall app or remove runtime packages.
# There is intentionally no /checks/app: tests import the installed wheel.
RUN uv sync --locked --only-group dev --no-install-project --inexact \
    && uv pip check --python /app/.venv/bin/python
CMD ["python", "-m", "pytest", "-q"]
